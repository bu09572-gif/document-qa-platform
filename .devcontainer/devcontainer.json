{
  "name": "ai-ml-portfolio",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "hostRequirements": { "cpus": 4, "memory": "8gb", "storage": "32gb" },
  "postCreateCommand": "pip install -e '.[dev]' && curl -fsSL https://ollama.com/install.sh | sh",
  "postStartCommand": "nohup ollama serve > /tmp/ollama.log 2>&1 &",
  "containerEnv": { "PYTHONPATH": "src" },
  "forwardPorts": [8000],
  "secrets": {
    "GROQ_API_KEY": { "description": "Optional, free (no credit card): faster hosted Llama. Leave empty to use the local Ollama model." }
  },
  "customizations": { "vscode": { "extensions": ["ms-python.python", "charliermarsh.ruff"] } }
}
